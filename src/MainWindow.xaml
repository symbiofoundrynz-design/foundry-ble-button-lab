<Window x:Class="FoundryBLEButtonLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Foundry BLE Button Lab v0.1" Height="760" Width="1250" MinHeight="620" MinWidth="980">
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Scan" Width="80" Click="Scan_Click"/><Button Content="Stop" Width="80" Margin="6,0" Click="Stop_Click"/><Button Content="Arm Discovery" Width="110" Margin="0,0,6,0" Click="Discovery_Click"/><Button Content="Pair" Width="80" Click="Pair_Click"/><Button Content="Connect / Inspect" Width="120" Margin="6,0" Click="Connect_Click"/><Button Content="Subscribe All" Width="110" Click="Subscribe_Click"/><TextBlock Margin="18,5,4,0" Text="Alias:"/><ComboBox x:Name="AliasBox" Width="90" SelectedIndex="0"><ComboBoxItem Content="BLACK"/><ComboBoxItem Content="PINK"/><ComboBoxItem Content="BLUE"/></ComboBox><Button Content="Assign" Width="75" Margin="6,0" Click="Assign_Click"/><Button Content="Ignore" Width="75" Click="Ignore_Click"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><GroupBox Header="Live BLE Devices" Margin="0,0,6,6"><DataGrid x:Name="DevicesGrid" ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="65"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="120"/><DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="55"/><DataGridTextColumn Header="ADV" Binding="{Binding AdvCount}" Width="55"/><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="135"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="Seen" Binding="{Binding LastSeenText}" Width="75"/></DataGrid.Columns></DataGrid></GroupBox>
<GroupBox Grid.Column="1" Header="GATT Inspector" Margin="6,0,0,6"><DataGrid ItemsSource="{Binding Gatt}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Characteristic" Binding="{Binding Characteristic}" Width="*"/><DataGridTextColumn Header="Properties" Binding="{Binding Properties}" Width="150"/></DataGrid.Columns></DataGrid></GroupBox></Grid>
<Grid Grid.Row="2">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,6">
    <StackPanel Orientation="Horizontal">
      <TextBlock FontWeight="Bold" Text="Discovery Status: "/>
      <TextBlock x:Name="DiscoveryStatusText" FontWeight="Bold" Text="IDLE"/>
    </StackPanel>
  </Border>
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <GroupBox Header="Raw Event Log" Margin="0,0,6,0">
      <TextBox x:Name="LogBox" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </GroupBox>
    <GroupBox Grid.Column="1" Header="Discovery Console" Margin="6,0,0,0">
      <TextBox x:Name="DiscoveryLogBox" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </GroupBox>
  </Grid>
</Grid></Grid></Window>


